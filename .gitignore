# ==========================================
logs/*.log
*.log
!logs/.gitkeep

# CSV export logs (Delta order/fills history)
*.csv

# ==========================================
# 5. Virtual Environments & Editor Settings
# ==========================================
.venv/
venv/
ENV/
env/

# VS Code & PyCharm
.vscode/
.idea/
*.swp
*.swo

# OS Generated
.DS_Store
Thumbs.db