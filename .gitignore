# ==========================================
# 1. Environment & API Secrets (CRITICAL)
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# 2. Python Bytecode & Cache Files
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

